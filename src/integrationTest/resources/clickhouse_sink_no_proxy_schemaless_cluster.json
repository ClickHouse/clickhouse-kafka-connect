{
  "name": "%s",
  "config": {
    "value.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "name": "%s",
    "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
    "transforms": "kafkaCoordinates",
    "transforms.kafkaCoordinates.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.kafkaCoordinates.partition.field": "kafka_partition",
    "transforms.kafkaCoordinates.offset.field": "kafka_offset",
    "tasks.max": "%d",
    "topics": "%s",
    "hostname": "%s",
    "port": "%s",
    "database": "%s",
    "username": "%s",
    "password": "%s",
    "ssl": "%b",
    "exactlyOnce" : "%b",
    "keeperOnCluster" : "%s"
  }
}
